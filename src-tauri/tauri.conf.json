{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxA11y",
  "version": "0.1.0",
  "identifier": "org.voxa11y.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoxA11y Desktop - Tekst-naar-Spraak & Accessibility Engine",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      },
      {
        "label": "overlay",
        "title": "VoxA11y Floating Widget",
        "width": 360,
        "height": 90,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "VoxA11y Desktop (Ctrl+Shift+Space to Play/Pause)"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "nl-NL"
      },
      "nsis": {
        "languages": ["Dutch", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libspeechd-dev", "libatspi2.0-0"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
